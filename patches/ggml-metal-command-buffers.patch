diff --git a/src/ggml-metal/ggml-metal.cpp b/src/ggml-metal/ggml-metal.cpp
index a1003b3..cce983c 100644
--- a/src/ggml-metal/ggml-metal.cpp
+++ b/src/ggml-metal/ggml-metal.cpp
@@ -591,0 +592,17 @@ static ggml_guid_t ggml_backend_metal_guid(void) {
+static int ggml_backend_metal_n_cb(void) {
+    const char * value = getenv("GGML_METAL_N_CB");
+    if (value == NULL) {
+        return 1;
+    }
+
+    char * end = NULL;
+    const long parsed = strtol(value, &end, 10);
+    if (end == value || *end != '\0' || parsed < 1 || parsed > 32) {
+        GGML_LOG_WARN("%s: ignoring invalid GGML_METAL_N_CB=%s (expected 1-32)\n",
+                      __func__, value);
+        return 1;
+    }
+
+    return (int) parsed;
+}
+
@@ -611 +628 @@ ggml_backend_t ggml_backend_metal_init(void) {
-    ggml_backend_metal_set_n_cb(backend, 1);
+    ggml_backend_metal_set_n_cb(backend, ggml_backend_metal_n_cb());
@@ -705 +722 @@ static ggml_backend_t ggml_backend_metal_device_init_backend(ggml_backend_dev_t
-    ggml_backend_metal_set_n_cb(backend, 1);
+    ggml_backend_metal_set_n_cb(backend, ggml_backend_metal_n_cb());
