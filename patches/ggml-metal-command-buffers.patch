+    // divide all nodes evenly instead; throughput is secondary to bounded
+    // command-buffer duration in this mode.
+    const int n_main = n_cb > 2
+        ? (gf->n_nodes + n_cb) / (n_cb + 1)
+        : MAX(64, 0.1*gf->n_nodes);
