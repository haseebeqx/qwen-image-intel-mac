@@ -449,0 +447,10 @@ enum ggml_status ggml_metal_graph_compute(ggml_metal_t ctx, struct ggml_cgraph *
+    // Upstream front-loads at least 64 nodes into the main command buffer to
+    // overlap GPU execution with encoding the remaining buffers. On slow
+    // discrete GPUs that buffer can exceed the macOS watchdog even when the
